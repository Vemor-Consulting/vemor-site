---
import Base from '../layouts/Base.astro';
import { caseStudies } from '../content/caseStudies';

interface Props { slug: string; lang?: 'en' | 'es'; }
const { slug, lang = 'en' } = Astro.props;
const base = lang === 'es' ? '/es' : '';

const idx = caseStudies.findIndex((c) => c.slug === slug);
const t = caseStudies[idx][lang];
const next = caseStudies[(idx + 1) % caseStudies.length];

const ui = {
  en: { tag: 'Case Study', next: 'Next case study', title: 'Have a process where a mistake costs money?', cta1: 'Book a Call', cta2: 'Send a Message', all: '← All case studies' },
  es: { tag: 'Caso', next: 'Siguiente caso', title: '¿Tienes un proceso donde un error cuesta dinero?', cta1: 'Agenda una llamada', cta2: 'Envía un mensaje', all: '← Todos los casos' },
}[lang];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${t.h1a} ${t.h1b}`,
  description: t.metaDesc,
  inLanguage: lang,
  author: { '@type': 'Organization', name: 'Vemor', url: 'https://vemor.ai' },
  publisher: { '@type': 'Organization', name: 'Vemor Consulting LLC', url: 'https://vemor.ai' },
};
---
<Base title={t.metaTitle} description={t.metaDesc} schema={schema} path={`${base}/case-studies/${slug}`} lang={lang} translated={true}>
  <section class="hero" style="min-height:0; padding-bottom:56px;">
    <a href={`${base || '/'}#case-studies`} class="case-back">{ui.all}</a>
    <span class="hero-tagline">{ui.tag} · {t.badge}</span>
    <h1>{t.h1a}<br /><span class="gold">{t.h1b}</span></h1>
    <p class="hero-sub">{t.sub}</p>
    <div class="hero-proof case-proof">
      {t.stats.map(([v, l]) => (
        <div class="proof-item">
          <span class="proof-value">{v}</span>
          <span class="proof-label">{l}</span>
        </div>
      ))}
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="case-grid">
      <aside class="case-aside">
        <span class="label">{t.glanceTitle}</span>
        <dl class="case-glance">
          {t.glance.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        </dl>
      </aside>
      <article class="case-body story-content">
        {t.sections.map((s) => (
          <>
            <h4>{s.h}</h4>
            {s.p.map((p) => <p>{p}</p>)}
          </>
        ))}
      </article>
    </div>
  </section>

  <div class="section-full soft">
    <div class="inner" style="text-align:center;">
      <span class="label">{ui.next}</span>
      <a href={`${base}/case-studies/${next.slug}`} class="case-next">
        {next[lang].h1a} <span class="gold">{next[lang].h1b}</span> →
      </a>
    </div>
  </div>

  <section style="text-align:center;">
    <h2 class="title">{ui.title}</h2>
    <div class="hero-ctas" style="justify-content:center; margin-top:32px;">
      <a href="https://Vemor.as.me/" class="btn-primary">{ui.cta1}</a>
      <a href={`${base}/contact`} class="btn-secondary">{ui.cta2}</a>
    </div>
  </section>
</Base>
