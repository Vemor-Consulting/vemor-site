---
import Base from '../layouts/Base.astro';

interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const base = lang === 'es' ? '/es' : '';

const copy = {
  en: {
    metaTitle: 'Vemor | AI Systems Built, Verified, and Operated',
    metaDesc: 'Vemor builds and runs AI systems for the parts of your business where a mistake costs money. Every figure traced to its source, every exception sent to a person. English and Spanish. San Diego, serving the U.S. and Mexico.',
    schemaDesc: 'Vemor builds and runs verified AI systems for operations, and owns the products built on them. English and Spanish.',
    hero: {
      tag: 'AI Systems, Built and Operated',
      h1a: 'AI that does the work', h1b: 'and shows the work.',
      sub: 'Anyone can build an AI tool now. Making it hold up when money depends on it is the hard part. Vemor builds and runs AI systems for the parts of your business where a mistake costs money, and we answer for them.',
      cta1: 'Talk to Vemor', cta2: 'See the case studies',
    },
    proof: [
      ['30+ hrs/wk', 'Manual reconciliation eliminated for one operator'],
      ['20,000+', 'Legal matters tracked and verified'],
      ['EN / ES', 'Built and operated in both languages'],
    ],
    services: {
      label: 'What We Do',
      title: 'Three ways to work with Vemor.',
      cards: [
        { h: 'Assess', tag: 'Find what is worth automating.', p: 'A few days inside your operation, then a written plan: what to build, what it costs, what it returns, and what to leave alone.', cta: 'Start here →', href: '/contact' },
        { h: 'Build', tag: 'One system, fixed scope.', p: 'One expensive problem, solved on the tools you already run. Scope and price agreed before the build, proven on your real data before it goes live.', cta: 'How builds work →', href: '/builds' },
        { h: 'Run', tag: 'We operate it and answer for it.', p: 'Vemor monitors the system, handles the exceptions, reports on what it did, and fixes it when something breaks.', cta: 'Managed operations →', href: '/operations', featured: true },
      ],
    },
    cases: {
      label: 'Case Studies',
      title: 'How the work actually goes.',
      sub: 'What the problem was, what we built, how we know it works, and what broke along the way.',
      cards: [
        { badge: 'Multi-Location Operator', h: 'One report became four systems.', stat: '30+ hrs/wk of manual reconciliation, eliminated', p: 'The bookkeeper spent the week matching sales to card settlements by hand. Now a nightly system does the matching and a person reviews only the exceptions.', href: '/case-studies/reconciliation' },
        { badge: 'Legal Data', h: 'Settlement numbers attorneys can check.', stat: '20,000+ matters tracked, every figure matched to source', p: 'An extraction engine for court filings where a number that cannot be matched to its source is withheld, not guessed. Including the week the check started failing.', href: '/case-studies/settlement-verification' },
      ],
      read: 'Read the case study →',
      products: 'Vemor also builds and runs its own products: <a href="/comps">Vemor Comps</a> for employment attorneys and <a href="CONTACT">Pizarrón</a> for restaurant groups.',
    },
    standard: {
      label: 'The Vemor Standard',
      title: 'What happens when the AI is wrong?',
      cards: [
        ['Every figure has a source', 'Outputs trace back to the record, filing, or transaction they came from. A number that cannot be matched is withheld, not guessed.'],
        ['Code does the math', 'AI reads documents and writes words. Code computes every number and checks it against fixed rules.'],
        ['Exceptions go to a person', 'What the system cannot resolve is flagged, with the reason, and sent to someone who can decide. Nothing fails quietly.'],
      ],
    },
    final: {
      title: 'Have a process where a mistake costs money?',
      sub: 'Tell us what it is. You will get a straight answer on whether it is worth automating, and what it would take to trust the result.',
      cta1: 'Book a Call', cta2: 'Send a Message',
    },
  },
  es: {
    metaTitle: 'Vemor | Sistemas de IA construidos, verificados y operados',
    metaDesc: 'Vemor construye y opera sistemas de IA para las partes de tu negocio donde un error cuesta dinero. Cada cifra con su fuente, cada excepción revisada por una persona. Español e inglés. San Diego, con servicio en México y Estados Unidos.',
    schemaDesc: 'Vemor construye y opera sistemas de IA verificables para operaciones, y es dueña de los productos construidos sobre ellos. Español e inglés.',
    hero: {
      tag: 'Sistemas de IA, construidos y operados',
      h1a: 'IA que hace el trabajo', h1b: 'y rinde cuentas.',
      sub: 'Hoy cualquiera puede armar una herramienta de IA. Lo difícil es que aguante cuando hay dinero de por medio. Vemor construye y opera sistemas de IA para las partes de tu negocio donde un error cuesta dinero, y respondemos por ellos.',
      cta1: 'Habla con Vemor', cta2: 'Ver los casos',
    },
    proof: [
      ['30+ h/sem', 'De conciliación manual eliminadas para un solo operador'],
      ['20,000+', 'Asuntos legales rastreados y verificados'],
      ['ES / EN', 'Construido y operado en los dos idiomas'],
    ],
    services: {
      label: 'Qué hacemos',
      title: 'Tres formas de trabajar con Vemor.',
      cards: [
        { h: 'Diagnóstico', tag: 'Saber qué vale la pena automatizar.', p: 'Unos días dentro de tu operación y luego un plan por escrito: qué construir, cuánto cuesta, cuánto regresa y qué conviene dejar como está.', cta: 'Empieza aquí →', href: '/contact' },
        { h: 'Construcción', tag: 'Un sistema, alcance fijo.', p: 'Un problema que cuesta caro, resuelto sobre las herramientas que ya usas. Alcance y precio acordados antes de construir, probado con tus datos reales antes de operar.', cta: 'Cómo funciona →', href: '/builds' },
        { h: 'Operación', tag: 'Lo operamos y respondemos por él.', p: 'Vemor vigila el sistema, atiende las excepciones, reporta lo que hizo y lo arregla cuando algo falla.', cta: 'Operaciones administradas →', href: '/operations', featured: true },
      ],
    },
    cases: {
      label: 'Casos',
      title: 'Cómo se hace el trabajo en la práctica.',
      sub: 'Cuál era el problema, qué construimos, cómo sabemos que funciona y qué falló en el camino.',
      cards: [
        { badge: 'Operador con varias sucursales', h: 'Un reporte se convirtió en cuatro sistemas.', stat: '30+ h/sem de conciliación manual, eliminadas', p: 'Contabilidad pasaba la semana cuadrando ventas contra los depósitos de tarjeta a mano. Hoy un sistema nocturno hace el cruce y una persona revisa solo las excepciones.', href: '/case-studies/reconciliation' },
        { badge: 'Datos legales', h: 'Cifras de acuerdos que los abogados pueden comprobar.', stat: 'Más de 20,000 asuntos, cada cifra cotejada con su fuente', p: 'Un motor de extracción de expedientes donde un número que no coincide con su fuente no se publica. No se adivina. Incluida la semana en que la verificación empezó a fallar.', href: '/case-studies/settlement-verification' },
      ],
      read: 'Leer el caso →',
      products: 'Vemor también construye y opera productos propios: <a href="/comps">Vemor Comps</a> para abogados laborales y <a href="CONTACT">Pizarrón</a> para grupos restauranteros.',
    },
    standard: {
      label: 'El estándar Vemor',
      title: '¿Qué pasa cuando la IA se equivoca?',
      cards: [
        ['Cada cifra tiene fuente', 'Los resultados se rastrean hasta el registro, el documento o la transacción de donde salieron. Si un número no coincide, no se publica. No se adivina.'],
        ['El código hace las cuentas', 'La IA lee documentos y redacta. El código calcula cada número y lo valida contra reglas fijas.'],
        ['Las excepciones van a una persona', 'Lo que el sistema no puede resolver se marca, con el motivo, y llega a alguien que puede decidir. Nada falla en silencio.'],
      ],
    },
    final: {
      title: '¿Tienes un proceso donde un error cuesta dinero?',
      sub: 'Cuéntanos cuál es. Te diremos sin rodeos si vale la pena automatizarlo y qué haría falta para confiar en el resultado.',
      cta1: 'Agenda una llamada', cta2: 'Envía un mensaje',
    },
  },
};
const t = copy[lang];
const link = (href: string) => `${base}${href}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Vemor',
  description: t.schemaDesc,
  url: 'https://vemor.ai',
  areaServed: ['United States', 'Mexico'],
};
---
<Base title={t.metaTitle} description={t.metaDesc} schema={schema} path={base || '/'} lang={lang} translated={true}>
  <!-- HERO -->
  <section class="hero">
    <span class="hero-tagline">{t.hero.tag}</span>
    <h1>{t.hero.h1a}<br /><span class="gold">{t.hero.h1b}</span></h1>
    <p class="hero-sub">{t.hero.sub}</p>
    <div class="hero-ctas">
      <a href={link('/contact')} class="btn-primary">{t.hero.cta1}</a>
      <a href="#case-studies" class="btn-secondary">{t.hero.cta2}</a>
    </div>
    <div class="hero-proof">
      {t.proof.map(([v, l]) => (
        <div class="proof-item">
          <span class="proof-value">{v}</span>
          <span class="proof-label">{l}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT WE DO -->
  <div class="section-full soft" id="services">
    <div class="inner">
      <span class="label">{t.services.label}</span>
      <h2 class="title">{t.services.title}</h2>
      <div class="cards-3" style="margin-top:40px;">
        {t.services.cards.map((c) => (
          <div class={c.featured ? 'card featured' : 'card'}>
            <h3>{c.h}</h3>
            <p class="tagline">{c.tag}</p>
            <p>{c.p}</p>
            <a href={link(c.href)} class="card-cta" style="margin-top:20px;">{c.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CASE STUDIES -->
  <section id="case-studies">
    <span class="label">{t.cases.label}</span>
    <h2 class="title">{t.cases.title}</h2>
    <p class="sub">{t.cases.sub}</p>
    <div class="cards-2">
      {t.cases.cards.map((c) => (
        <a href={link(c.href)} class="card case-card">
          <span class="card-badge">{c.badge}</span>
          <h3>{c.h}</h3>
          <p class="tagline">{c.stat}</p>
          <p>{c.p}</p>
          <span class="card-cta" style="margin-top:20px;">{t.cases.read}</span>
        </a>
      ))}
    </div>
    <p class="products-line" set:html={t.cases.products.replace('CONTACT', link('/contact'))} />
  </section>

  <!-- THE STANDARD -->
  <div class="section-full soft" id="standard">
    <div class="inner">
      <span class="label">{t.standard.label}</span>
      <h2 class="title">{t.standard.title}</h2>
      <div class="cards-3" style="margin-top:40px;">
        {t.standard.cards.map(([h, p]) => (
          <div class="card"><h3>{h}</h3><p>{p}</p></div>
        ))}
      </div>
    </div>
  </div>

  <!-- FINAL CTA -->
  <section style="text-align:center;">
    <h2 class="title">{t.final.title}</h2>
    <p class="sub" style="margin-left:auto; margin-right:auto;">{t.final.sub}</p>
    <div class="hero-ctas" style="justify-content:center;">
      <a href="https://Vemor.as.me/" class="btn-primary">{t.final.cta1}</a>
      <a href={link('/contact')} class="btn-secondary">{t.final.cta2}</a>
    </div>
  </section>
</Base>
