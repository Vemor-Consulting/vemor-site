---
import Base from '../layouts/Base.astro';

interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const base = lang === 'es' ? '/es' : '';

const copy = {
  en: {
    metaTitle: 'Custom AI Builds | Fixed Scope, Proven on Your Data | Vemor',
    metaDesc: 'One system, fixed scope, priced before the build: reconciliation engines, document pipelines, asset tracking, bilingual voice agents. Built on the tools you already run. Serving the U.S. and Mexico.',
    schemaType: 'Custom AI and automation builds',
    schemaDesc: 'Fixed-scope custom automation: one system, built on existing tools, quoted before the build starts and tested on real data before it goes live.',
    tag: 'Custom Builds',
    h1a: 'One problem.', h1b: 'Solved for good.',
    sub: 'Some problems do not need a program. They need one system that works: a fixed scope, a price agreed before the build, and proof on your real data before it goes live.',
    cta: 'Book a Discovery Call',
    exLabel: 'What a Build Looks Like',
    exTitle: 'Real systems, running today.',
    ex: [
      ['A reconciliation engine', 'Reads the client\'s existing point-of-sale database every night, reconciles sales across four locations, flags payment errors and unauthorized discounts, and emails a finished report before opening. A full-time job became an hour of review.'],
      ['A document pipeline', 'Reads thousands of legal filings, extracts the numbers with evidence behind every figure, validates them with hard arithmetic rules, and produces a benchmark report in seconds. Work that used to take hours per case.'],
      ['An asset tracker', 'RFID tracking for rental equipment across four physical locations. Readers at each site, cloud sync, cross-checking against invoices, and an alert at closing when a unit is missing. Hardware and software, delivered as one working system.'],
      ['A bilingual voice agent', 'Answers inbound calls in English and Spanish in the same conversation, books into the existing calendar, hands off to a person when the call needs one, and reports every call each week.'],
    ],
    voiceLink: 'Hear a live agent →',
    howLabel: 'How It Works',
    howTitle: 'Scope first. Price before build. No surprises.',
    steps: [
      ['Assessment', 'A paid operations assessment: a few days inside your workflow, then a written plan of what to automate, what it costs, and what it returns. The plan is yours either way.'],
      ['Fixed quote', 'You get the scope and the price before anything gets built. If we missed the estimate, that is Vemor\'s problem, not yours.'],
      ['Build and prove', 'Built on your existing tools and tested against your real work, not demo data. It ships when it survives your actual Tuesday.'],
      ['Your choice', 'Take the keys: documentation included, the system is yours. Or have Vemor operate it and answer for it.'],
    ],
    fit: [
      ['Good fit for a build', 'You know exactly what hurts: the nightly close, the quote follow-ups, the spreadsheet nobody trusts, the report that takes all Friday. One defined problem, one defined result. Many clients start here and move to <a href="OPS" style="color:var(--gold);">Managed AI Operations</a> once the first system proves itself.'],
      ['The same standard applies', 'Every build sits on top of what you already have and meets the same standard as everything Vemor operates: figures traced to their source, exceptions sent to a person, documentation delivered with the system.'],
    ],
    finalTitle: 'One process. Tell us which.',
    finalSub: 'You will get a straight answer on whether a build is worth it, and what it would take to trust the result. Sometimes the honest answer is no.',
    cta2: 'Send a Message',
  },
  es: {
    metaTitle: 'Proyectos de IA a la medida | Alcance fijo, probado con tus datos | Vemor',
    metaDesc: 'Un sistema, alcance fijo y precio acordado antes de construir: conciliación automática, flujos de documentos, rastreo de activos, agentes de voz bilingües. Sobre las herramientas que ya usas. México y Estados Unidos.',
    schemaType: 'Proyectos de IA y automatización a la medida',
    schemaDesc: 'Automatización a la medida con alcance fijo: un sistema, montado sobre las herramientas existentes, cotizado antes de construir y probado con datos reales antes de entrar en operación.',
    tag: 'Proyectos a la medida',
    h1a: 'Un problema.', h1b: 'Resuelto de una vez.',
    sub: 'Hay problemas que no necesitan un programa completo. Necesitan un sistema que funcione: alcance fijo, precio acordado antes de construir y pruebas con tus datos reales antes de entrar en operación.',
    cta: 'Agenda una llamada',
    exLabel: 'Cómo se ve un proyecto',
    exTitle: 'Sistemas reales, funcionando hoy.',
    ex: [
      ['Un motor de conciliación', 'Lee cada noche la base de datos del punto de venta del cliente, concilia las ventas de cuatro sucursales, marca errores de cobro y descuentos no autorizados, y envía un reporte terminado antes de abrir. Un trabajo de tiempo completo se convirtió en una hora de revisión.'],
      ['Un flujo de documentos', 'Lee miles de expedientes legales, extrae las cifras con evidencia detrás de cada una, las valida con reglas aritméticas fijas y genera un reporte comparativo en segundos. Trabajo que antes tomaba horas por caso.'],
      ['Un rastreador de activos', 'Rastreo RFID de equipo de renta en cuatro sucursales. Lectores en cada sitio, sincronización en la nube, cruce contra facturas y una alerta al cierre cuando falta una unidad. Hardware y software, entregados como un solo sistema.'],
      ['Un agente de voz bilingüe', 'Contesta llamadas en español y en inglés dentro de la misma conversación, agenda en el calendario que ya usas, transfiere a una persona cuando la llamada lo requiere y reporta cada llamada cada semana.'],
    ],
    voiceLink: 'Escucha un agente en vivo →',
    howLabel: 'Cómo funciona',
    howTitle: 'Primero el alcance. El precio antes de construir. Sin sorpresas.',
    steps: [
      ['Diagnóstico', 'Un diagnóstico de operaciones pagado: unos días dentro de tu proceso y luego un plan por escrito de qué automatizar, cuánto cuesta y cuánto regresa. El plan es tuyo de cualquier forma.'],
      ['Cotización fija', 'Recibes el alcance y el precio antes de que se construya nada. Si calculamos mal, el problema es de Vemor, no tuyo.'],
      ['Construir y comprobar', 'Montado sobre tus herramientas y probado con tu trabajo real, no con datos de demo. Se entrega cuando aguanta un martes de verdad.'],
      ['Tú decides', 'Te quedas con las llaves: el sistema es tuyo, con documentación. O Vemor lo opera y responde por él.'],
    ],
    fit: [
      ['Para quién es un proyecto', 'Sabes exactamente qué duele: el corte de cada noche, el seguimiento de cotizaciones, la hoja de cálculo en la que nadie confía, el reporte que se lleva todo el viernes. Un problema definido, un resultado definido. Muchos clientes empiezan aquí y pasan a <a href="OPS" style="color:var(--gold);">Operaciones de IA administradas</a> cuando el primer sistema demuestra que funciona.'],
      ['Aplica el mismo estándar', 'Cada proyecto se monta sobre lo que ya tienes y cumple el mismo estándar que todo lo que Vemor opera: cifras rastreadas hasta su fuente, excepciones en manos de una persona y documentación entregada con el sistema.'],
    ],
    finalTitle: 'Un proceso. Dinos cuál.',
    finalSub: 'Te diremos sin rodeos si vale la pena construirlo y qué haría falta para confiar en el resultado. A veces la respuesta honesta es que no.',
    cta2: 'Envía un mensaje',
  },
};
const t = copy[lang];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: t.schemaType,
  provider: { '@type': 'Organization', name: 'Vemor', url: 'https://vemor.ai' },
  description: t.schemaDesc,
  areaServed: ['United States', 'Mexico'],
};
---
<Base title={t.metaTitle} description={t.metaDesc} schema={schema} path={`${base}/builds`} lang={lang} translated={true}>
  <section class="hero" style="min-height:0; padding-bottom:60px;">
    <span class="hero-tagline">{t.tag}</span>
    <h1>{t.h1a}<br /><span class="gold">{t.h1b}</span></h1>
    <p class="hero-sub">{t.sub}</p>
    <div class="hero-ctas">
      <a href="https://Vemor.as.me/" class="btn-primary">{t.cta}</a>
    </div>
  </section>

  <div class="section-full soft">
    <div class="inner">
      <span class="label">{t.exLabel}</span>
      <h2 class="title">{t.exTitle}</h2>
      <div class="cards-2">
        {t.ex.map(([h, p], i) => (
          <div class="card">
            <h3>{h}</h3>
            <p>{p}</p>
            {i === 3 && <a href="/voice" class="card-cta" style="margin-top:16px;">{t.voiceLink}</a>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section>
    <span class="label">{t.howLabel}</span>
    <h2 class="title">{t.howTitle}</h2>
    <div class="steps steps-4">
      {t.steps.map(([h, p], i) => (
        <div class="step">
          <div class="step-num">{i + 1}</div>
          <h3>{h}</h3>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="section-full soft">
    <div class="inner">
      <div class="story-grid">
        {t.fit.map(([h, p]) => (
          <div class="story-content">
            <h4>{h}</h4>
            <p set:html={p.replace('OPS', `${base}/operations`)} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <section style="text-align:center;">
    <h2 class="title">{t.finalTitle}</h2>
    <p class="sub" style="margin-left:auto; margin-right:auto;">{t.finalSub}</p>
    <div class="hero-ctas" style="justify-content:center;">
      <a href="https://Vemor.as.me/" class="btn-primary">{t.cta}</a>
      <a href={`${base}/contact`} class="btn-secondary">{t.cta2}</a>
    </div>
  </section>
</Base>
