---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD structured data for this page (object or array of objects). */
  schema?: object | object[];
  /** Path for canonical URL, e.g. "/voice". Defaults to current URL. */
  path?: string;
  /** Show the Sofia/Vapi voice demo widget. Only the Voice page does. */
  showWidget?: boolean;
  /** Page language. Spanish pages live under /es. */
  lang?: 'en' | 'es';
  /** True when this page exists in both languages at the same slug (/x and /es/x). */
  translated?: boolean;
}

const { title, description, schema, path, showWidget = false, lang = 'en', translated = false } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href.replace(/\.html$/, '');

// Language switch: a translated page links to its counterpart, anything else to the other home page.
const here = (path ?? Astro.url.pathname).replace(/\.html$/, '').replace(/\/$/, '') || '/';
const enPath = lang === 'es' ? here.replace(/^\/es/, '') || '/' : here;
const esPath = enPath === '/' ? '/es' : `/es${enPath}`;
const enHref = lang === 'es' ? (translated ? enPath : '/') : here;
const esHref = lang === 'es' ? here : (translated ? esPath : '/es');
const abs = (p: string) => new URL(p, Astro.site).href;

const base = lang === 'es' ? '/es' : '';


const nav = {
  en: { builds: 'Builds', operations: 'Operations', cases: 'Case Studies', about: 'About', contact: 'Contact', cta: 'Book a Call',
        home: 'Vemor home', menu: 'Menu', langLabel: 'Language', footBuilds: 'Custom Builds', footOps: 'Managed AI Operations',
        terms: 'Terms', privacy: 'Privacy', place: 'San Diego, CA · English and Spanish' },
  es: { builds: 'Proyectos', operations: 'Operaciones', cases: 'Casos', about: 'Nosotros', contact: 'Contacto', cta: 'Agenda una llamada',
        home: 'Inicio de Vemor', menu: 'Menú', langLabel: 'Idioma', footBuilds: 'Proyectos a la medida', footOps: 'Operaciones de IA administradas',
        terms: 'Términos', privacy: 'Privacidad', place: 'San Diego, CA · Español e inglés' },
}[lang];

// Organization schema ships on every page; page-specific schema gets appended.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://vemor.ai/#organization',
  name: 'Vemor',
  legalName: 'Vemor Consulting LLC',
  url: 'https://vemor.ai',
  logo: 'https://vemor.ai/logo.png',
  image: 'https://vemor.ai/logo.png',
  email: 'gio@vemor.ai',
  telephone: '+18584226344',
  foundingDate: '2025-02',
  founder: { '@type': 'Person', name: 'Giovanni Vega Garcia' },
  address: { '@type': 'PostalAddress', addressLocality: 'San Diego', addressRegion: 'CA', addressCountry: 'US' },
  areaServed: ['San Diego', 'United States', 'Mexico'],
  knowsLanguage: ['en', 'es'],
};
const schemas = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {translated && (
    <>
      <link rel="alternate" hreflang="en" href={abs(enPath)} />
      <link rel="alternate" hreflang="es" href={abs(esPath)} />
      <link rel="alternate" hreflang="x-default" href={abs(enPath)} />
    </>
  )}
  <link rel="icon" type="image/png" href="/lion.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://vemor.ai/logo.png" />
  <meta property="og:site_name" content="Vemor" />
  <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JLW54LGKWN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JLW54LGKWN');
  </script>
</head>
<body>
  <nav>
    <a href={base || '/'} class="nav-brand" aria-label={nav.home}>
      <img src="/lion.png" alt="Vemor" class="nav-logo" />
      <span class="nav-name">Vemor</span>
    </a>
    <button class="nav-toggle" aria-label={nav.menu} onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
    <ul class="nav-links">
      <li><a href={`${base}/builds`}>{nav.builds}</a></li>
      <li><a href={`${base}/operations`}>{nav.operations}</a></li>
      <li><a href={`${base || '/'}#case-studies`}>{nav.cases}</a></li>
      <li><a href={`${base}/about`}>{nav.about}</a></li>
      <li><a href={`${base}/contact`}>{nav.contact}</a></li>
      <li>
        <div class="lang-switch" role="group" aria-label={nav.langLabel}>
          <a href={enHref} hreflang="en" lang="en" class={lang === 'en' ? 'on' : ''} aria-current={lang === 'en' ? 'true' : undefined} title="English">EN</a>
          <a href={esHref} hreflang="es" lang="es" class={lang === 'es' ? 'on' : ''} aria-current={lang === 'es' ? 'true' : undefined} title="Español">ES</a>
        </div>
      </li>
      <li><a href="https://Vemor.as.me/" class="nav-cta">{nav.cta}</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-brand">
      <img src="/lion.png" alt="" class="footer-logo" />
      <span class="footer-name">Vemor</span>
    </div>
    <ul class="footer-links">
      <li><a href={`${base}/builds`}>{nav.footBuilds}</a></li>
      <li><a href={`${base}/operations`}>{nav.footOps}</a></li>
      <li><a href="/comps">Vemor Comps</a></li>
      <li><a href="/voice">Vemor Voice</a></li>
      <li><a href={`${base}/about`}>{nav.about}</a></li>
      <li><a href="mailto:gio@vemor.ai">gio@vemor.ai</a></li>
    </ul>
    <span class="footer-copy">© {new Date().getFullYear()} Vemor Consulting LLC · {nav.place} · <a href="/terms" style="color:var(--text-muted);">{nav.terms}</a> · <a href="/privacy" style="color:var(--text-muted);">{nav.privacy}</a></span>
  </footer>

  {showWidget && (
    <script is:inline>
      (function (d, t) {
        var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
        g.src = 'https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
        g.defer = true; g.async = true;
        s.parentNode.insertBefore(g, s);
        g.onload = function () {
          window.vapiSDK && window.vapiSDK.run({
            apiKey: '8217cf32-082a-4367-8c21-da09af2f730d',
            assistant: '9ab26c49-a69e-4dec-a8b2-71994ac6a86b',
            config: {
              position: 'bottom-right',
              offset: '24px',
              width: '60px',
              height: '60px',
              idle: {
                color: '#a68b2d', type: 'pill',
                title: 'Talk to Sofia', subtitle: 'Live AI demo',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/phone.svg',
              },
              loading: {
                color: '#a68b2d', type: 'pill',
                title: 'Connecting...', subtitle: 'One moment',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/loader-2.svg',
              },
              active: {
                color: '#dc2626', type: 'pill',
                title: 'Call in progress', subtitle: 'Click to end',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/phone-off.svg',
              },
            },
          });
        };
      })(document, 'script');
    </script>
  )}
</body>
</html>
