---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD structured data for this page (object or array of objects). */
  schema?: object | object[];
  /** Path for canonical URL, e.g. "/voice". Defaults to current URL. */
  path?: string;
  /** Hide the Sofia/Vapi widget on this page (e.g. /comps targets attorneys, not SMBs). */
  hideWidget?: boolean;
}

const { title, description, schema, path, hideWidget } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href.replace(/\.html$/, '');

// Organization schema ships on every page; page-specific schema gets appended.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://vemor.ai/#organization',
  name: 'Vemor',
  legalName: 'Vemor Consulting LLC',
  url: 'https://vemor.ai',
  logo: 'https://vemor.ai/logo.png',
  image: 'https://vemor.ai/logo.png',
  email: 'gio@vemor.ai',
  telephone: '+18584226344',
  foundingDate: '2025-02',
  priceRange: '$$',
  founder: { '@type': 'Person', name: 'Giovanni Vega Garcia' },
  address: { '@type': 'PostalAddress', addressLocality: 'San Diego', addressRegion: 'CA', addressCountry: 'US' },
  areaServed: ['San Diego', 'United States', 'Mexico'],
  knowsLanguage: ['en', 'es'],
};
const schemas = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/lion.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://vemor.ai/logo.png" />
  <meta property="og:site_name" content="Vemor" />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JLW54LGKWN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JLW54LGKWN');
  </script>
</head>
<body>
  <nav>
    <a href="/" class="nav-brand" aria-label="Vemor home">
      <img src="/lion.png" alt="Vemor lion logo" class="nav-logo" />
      <span class="nav-name">Vemor</span>
    </a>
    <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/voice">Vemor Voice</a></li>
      <li><a href="/comps">Vemor Comps</a></li>
      <li><a href="/builds">Custom Builds</a></li>
      <li><a href="/operations">Managed AI Operations</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="https://Vemor.as.me/" class="nav-cta">Book a Call</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-brand">
      <img src="/lion.png" alt="" class="footer-logo" />
      <span class="footer-name">Vemor</span>
    </div>
    <ul class="footer-links">
      <li><a href="/voice">Vemor Voice</a></li>
      <li><a href="/comps">Vemor Comps</a></li>
      <li><a href="/builds">Custom Builds</a></li>
      <li><a href="/operations">Managed AI Operations</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="mailto:gio@vemor.ai">gio@vemor.ai</a></li>
    </ul>
    <span class="footer-copy">© {new Date().getFullYear()} Vemor Consulting LLC · San Diego, CA · English y Español</span>
  </footer>

  {!hideWidget && (
    <script is:inline>
      (function (d, t) {
        var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
        g.src = 'https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
        g.defer = true; g.async = true;
        s.parentNode.insertBefore(g, s);
        g.onload = function () {
          window.vapiSDK && window.vapiSDK.run({
            apiKey: '8217cf32-082a-4367-8c21-da09af2f730d',
            assistant: '9ab26c49-a69e-4dec-a8b2-71994ac6a86b',
            config: {
              position: 'bottom-right',
              offset: '24px',
              width: '60px',
              height: '60px',
              idle: {
                color: '#a68b2d', type: 'pill',
                title: 'Talk to Sofia', subtitle: 'Live AI demo',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/phone.svg',
              },
              loading: {
                color: '#a68b2d', type: 'pill',
                title: 'Connecting...', subtitle: 'One moment',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/loader-2.svg',
              },
              active: {
                color: '#dc2626', type: 'pill',
                title: 'Call in progress', subtitle: 'Click to end',
                icon: 'https://unpkg.com/lucide-static@0.321.0/icons/phone-off.svg',
              },
            },
          });
        };
      })(document, 'script');
    </script>
  )}
</body>
</html>
