---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found | Vemor"
  description="That page doesn't exist. Head back to vemor.ai."
  path="/404"
>
  <section class="hero" style="min-height:60vh; text-align:center; align-items:center;">
    <h1 style="margin-left:auto; margin-right:auto;">404. <span class="gold">This page took the day off.</span></h1>
    <p class="hero-sub" style="margin-left:auto; margin-right:auto;">
      Which is more than your busywork ever does. Let's get you back on track.
    </p>
    <div class="hero-ctas" style="justify-content:center;">
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </section>
</Base>
